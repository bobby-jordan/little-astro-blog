---
import { SITE_TITLE, url } from '../consts';

const links = [
  { href: url('/'), label: 'Home' },
  { href: url('/blog/'), label: 'Blog' },
  { href: url('/tags/'), label: 'Tags' },
  { href: url('/about/'), label: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '');
  return h === url('/').replace(/\/$/, '') ? path === h : path.startsWith(h);
};
---

<header>
  <div class="container bar">
    <a class="brand" href={url('/')}><span class="dot" aria-hidden="true"></span>{SITE_TITLE}</a>
    <nav>
      {links.map(({ href, label }) => (
        <a href={href} class:list={{ active: isActive(href) }}>{label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  header { border-bottom: 1px solid var(--border); margin-bottom: 3.5rem; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding-block: 1.1rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; color: var(--text); text-decoration: none; }
  .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--accent); }
  nav { display: flex; gap: 1.25rem; }
  nav a { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
  nav a:hover, nav a.active { color: var(--text); }
  nav a.active { box-shadow: inset 0 -2px 0 var(--accent); }
</style>
